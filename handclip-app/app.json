{
  "expo": {
    "name": "HandClip",
    "slug": "handclip-app",
    "scheme": "handclip",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.handclip.app"
    },
    "android": {
      "package": "com.handclip.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-video",
        {
          "supportsBackgroundAudio": true
        }
      ],
      "expo-image-picker",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
